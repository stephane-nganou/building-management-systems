{
  "realm": "bms",
  "enabled": true,
  "displayName": "Building Management",
  "loginTheme": "bms",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "fr"
  ],
  "defaultLocale": "en",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Owns buildings and manages assistants"
      },
      {
        "name": "assistant",
        "description": "Works on an owner's data within granted permissions"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bms-backend",
      "name": "Building Management Backend",
      "description": "The only client. Signs the browser in on the application's behalf, and holds the service account that creates owner and assistant accounts.",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bms-backend-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:4200/api/auth/callback/*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-bms-backend",
      "enabled": true,
      "serviceAccountClientId": "bms-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "owner",
      "email": "owner@bms.local",
      "firstName": "Olivia",
      "lastName": "Owner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "owner",
          "temporary": false
        }
      ],
      "realmRoles": [
        "owner"
      ]
    },
    {
      "username": "assistant",
      "email": "assistant@bms.local",
      "firstName": "Adam",
      "lastName": "Assistant",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "assistant",
          "temporary": false
        }
      ],
      "realmRoles": [
        "assistant"
      ]
    }
  ]
}
