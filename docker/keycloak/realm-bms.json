{
  "realm": "bms",
  "enabled": true,
  "displayName": "Hausbuch",
  "loginTheme": "bms",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "fr",
    "de"
  ],
  "defaultLocale": "en",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "smtpServer": {
    "host": "${BMS_SMTP_HOST:mailpit}",
    "port": "${BMS_SMTP_PORT:1025}",
    "from": "${BMS_SMTP_FROM:no-reply@hausbuch.local}",
    "fromDisplayName": "Hausbuch",
    "auth": "${BMS_SMTP_AUTH:false}",
    "user": "${BMS_SMTP_USER:}",
    "password": "${BMS_SMTP_PASSWORD:}",
    "starttls": "${BMS_SMTP_STARTTLS:false}",
    "ssl": "false"
  },
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Owns buildings and manages assistants"
      },
      {
        "name": "assistant",
        "description": "Works on an owner's data within granted permissions"
      },
      {
        "name": "admin",
        "description": "Runs the service: manages owners' accounts and subscriptions"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bms-backend",
      "name": "Building Management Backend",
      "description": "Signs the browser in on the application's behalf, and holds the service account that creates owner and assistant accounts.",
      "protocol": "openid-connect",
      "baseUrl": "${BMS_PUBLIC_URL:http://localhost:4200}/",
      "publicClient": false,
      "secret": "${BMS_KEYCLOAK_CLIENT_SECRET:bms-backend-secret}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "${BMS_PUBLIC_URL:http://localhost:4200}/api/auth/callback/*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${BMS_PUBLIC_URL:http://localhost:4200}/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bms-password-check",
      "name": "Building Management Password Check",
      "description": "Used by the backend alone, to confirm a user's current password before it is changed. Direct access grants only, so the browser never signs in through it; the backend holds its secret, the same one as bms-backend.",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BMS_KEYCLOAK_CLIENT_SECRET:bms-backend-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [],
      "defaultClientScopes": [
        "basic"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-bms-backend",
      "enabled": true,
      "serviceAccountClientId": "bms-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    }
  ]
}
