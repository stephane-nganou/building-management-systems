# Copy to .env.production on the server and fill in every value. It is ignored
# by git and holds every secret the stack has. Generate each password and the
# client secret with: openssl rand -base64 32

# The domain the application is served on. Its DNS A (and AAAA) record must
# point at this server before the first start, for Let's Encrypt to issue a
# certificate.
BMS_DOMAIN=hausbuch.example.com
# Where Let's Encrypt writes about expiring certificates.
ACME_EMAIL=ops@example.com

POSTGRES_DB=bms
POSTGRES_USER=bms
POSTGRES_PASSWORD=

# Keycloak's own administrator, for its console, reached only over an SSH tunnel.
KEYCLOAK_ADMIN=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_PORT=8081

# Shared by Keycloak and the backend, which signs the browser in as this client.
# The bms-password-check client holds the same secret; the sync service sets both
# on every start, so changing it here and restarting rotates it. The backend
# refuses to start with it blank or with the development default.
BMS_KEYCLOAK_CLIENT_SECRET=

# The application's first administrator, who signs owners up. The password is
# temporary: Keycloak asks for a new one at the first sign in.
BMS_ADMIN_USERNAME=admin
BMS_ADMIN_EMAIL=
BMS_ADMIN_PASSWORD=

# The SMTP relay Keycloak sends email through: the link that confirms a new
# owner's address, and password resets. Brevo's relay is smtp-relay.brevo.com,
# port 587 with STARTTLS. BMS_SMTP_FROM must be an address of a domain whose
# SPF and DKIM records the relay is allowed to sign for.
BMS_SMTP_HOST=smtp-relay.brevo.com
BMS_SMTP_PORT=587
BMS_SMTP_FROM=no-reply@hausbuch.example.com
BMS_SMTP_USER=
BMS_SMTP_PASSWORD=

# Printed on every invoice as its issuer.
BMS_INVOICE_ISSUER_NAME=Hausbuch

BACKUP_KEEP_DAYS=14

# The web log viewer, on the server's localhost only; see docs/DEPLOYMENT.md.
# Uncomment to start it with the stack; scripts/logs-prod.sh --viewer starts it
# on demand instead.
# COMPOSE_PROFILES=logs
LOGS_PORT=9999
