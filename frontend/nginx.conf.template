server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # The API is served from this same origin, which is the whole point: the
    # browser holds a session cookie for one host and the application never
    # learns that an identity provider exists. BACKEND_ORIGIN is substituted
    # from the environment when the container starts, so repointing it does not
    # need a new image.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build output never changes under the same name.
    location ~* \.(?:js|css|woff2?|png|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client side routing: unknown paths are handled by the app.
    #
    # The page may only load what this origin serves. The one inline script, which
    # sets the theme before the first paint, is allowed by its hash: change it in
    # src/index.html and this hash must change with it. Component styles are
    # inserted by Angular at runtime, hence 'unsafe-inline' for styles alone.
    # angular.json turns off critical CSS inlining, whose onload handler this
    # policy would block, leaving the stylesheet unapplied.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-x8lLcjYqckYrOBEJWMyPMXu/pwA0fC8HrWEfbd/XMC4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
}
